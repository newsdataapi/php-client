<?xml version="1.0" encoding="UTF-8"?>
<phpunit bootstrap="autoload.php"
         colors="true">
    <testsuites>
        <testsuite name="newsdataapi">
            <directory>tests</directory>
        </testsuite>
    </testsuites>

    <!-- PHPUnit 10 needs a configured source set to produce coverage; without
         it the runner warns "No filter is configured" and exits non-zero in
         CI. (PHPUnit 10 dropped the legacy <coverage><include> in favour of
         this <source> element.) -->
    <source>
        <include>
            <directory suffix=".php">src</directory>
        </include>
    </source>
</phpunit>
